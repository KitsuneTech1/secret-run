# Example secret-run role. Copy this to ~/.secret-roles/<role>.env and edit it.
#
# One mapping per line. The left side is the environment variable the child
# process will see. The right side names a Proton Pass item.
#
#   ENVVAR = Item Title                 # the item's password field
#   ENVVAR = Item Title :: fieldname    # a named field, case-insensitive
#   ENVVAR = SHARE_ID / ITEM_ID / field # explicit ids, most precise
#
# Blank lines and lines starting with # are ignored.
# Never put the Proton Pass access token in here. It belongs in
# ~/.secret-roles/.pat or the PROTON_PASS_PERSONAL_ACCESS_TOKEN variable.

# The deploy key for a staging box, taken from the item's password field.
DEPLOY_KEY = Staging Deploy Key

# A specific field on a multi-field item.
STRIPE_SECRET_KEY = Stripe Test Mode :: secret key

# The same item addressed by id, which never breaks when the title changes.
# DATABASE_URL = 7f3a.../9b21.../password
